node_modules/
.DS_Store
.dev.vars
.env
.env.*
!.dev.vars.example
worker/dist/
worker/pages/dist/
worker/.pages-bundle/
worker/wrangler.jsonc
worker/pages/wrangler.jsonc

# 快捷指令构建中间产物；仓库只提交 plist 源文件和中文名的最终签名文件。
shortcuts/*-unsigned.shortcut
shortcuts/laowang-*.shortcut

# 以下几条只针对仓库根目录的模块构建来源(本仓库只发布 dist/ 里的成品)。
# 必须带前导斜杠: 不带斜杠的 "src/" 会匹配任意层级, 把 worker/src/ 一起吞掉,
# 结果是新增的 worker 源码文件被静默忽略、提交时凭空消失。
/src/
/package.json
/package-lock.json
/rollup.config.js
